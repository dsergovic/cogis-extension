{
  "manifest_version": 3,
  "name": "Cogis — AI Search",
  "version": "0.1.0",
  "description": "Search your own ChatGPT, Claude, Gemini, Perplexity, and Grok conversation history from a single popup and jump straight back in. Dev-unpacked.",
  "action": {
    "default_title": "Cogis — AI Search",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://www.meta.ai/*",
    "https://meta.ai/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.perplexity.ai/*", "https://perplexity.ai/*"],
      "js": ["content/perplexity.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content/gemini.js"],
      "run_at": "document_idle"
    }
  ]
}
